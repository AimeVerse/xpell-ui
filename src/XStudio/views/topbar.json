{
  "_id": "xstudio-topbar",
  "_type": "view",
  "class": "xstudio-topbar",
  "_children": [
    {
      "_type": "label",
      "class": "xstudio-topbar-title",
      "_text": "Visual Xpell"
    },
    {
      "_id": "xstudio-theme-selector",
      "_type": "select",
      "class": "toolbar-theme-select",
      "_value": "dark",
      "value": "dark",
      "_options": [
        {
          "value": "terminal",
          "label": "Terminal"
        },
        {
          "value": "dark",
          "label": "Dark",
          "selected": true
        },
        {
          "value": "light",
          "label": "Light"
        }
      ],
      "_on": {
        "change": {
          "_module": "xstudio",
          "_op": "set-studio-theme",
          "_params": {
            "_theme": "$data"
          }
        }
      }
    },
    {
      "_type": "view",
      "class": "xstudio-topbar-spacer"
    },
    {
      "_id": "xstudio-apps-button",
      "_type": "button",
      "class": "xstudio-apps-button",
      "_text": "Apps",
      "_variant": "ghost",
      "title": "Open Apps",
      "_on": {
        "click": {
          "_module": "xvm",
          "_op": "load-server-app",
          "_params": {
            "_app_id": "vibe-system",
            "_env": "default",
            "_edit": false
          }
        }
      }
    },
    {
      "_id": "xstudio-portlet-toggle-prompt",
      "_type": "button",
      "class": "xstudio-portlet-toggle",
      "_text": "Prompt",
      "_variant": "ghost",
      "title": "Show Prompt",
      "aria-pressed": "false",
      "_on": {
        "click": {
          "_module": "xstudio",
          "_op": "toggle-portlet",
          "_params": {
            "_portlet": "prompt"
          }
        }
      }
    },
    {
      "_id": "xstudio-portlet-toggle-conversation",
      "_type": "button",
      "class": "xstudio-portlet-toggle xstudio-portlet-toggle-active",
      "_text": "Conversation",
      "_variant": "ghost",
      "title": "Hide Conversation",
      "aria-pressed": "true",
      "_on": {
        "click": {
          "_module": "xstudio",
          "_op": "toggle-portlet",
          "_params": {
            "_portlet": "conversation"
          }
        }
      }
    },
    {
      "_id": "xstudio-portlet-toggle-guide",
      "_type": "button",
      "class": "xstudio-portlet-toggle",
      "_text": "Guide",
      "_variant": "ghost",
      "title": "Show Guide",
      "aria-pressed": "false",
      "_on": {
        "click": {
          "_module": "xstudio",
          "_op": "toggle-portlet",
          "_params": {
            "_portlet": "guide"
          }
        }
      }
    },
    {
      "_id": "xstudio-portlet-toggle-inspector",
      "_type": "button",
      "class": "xstudio-portlet-toggle",
      "_text": "Inspector",
      "_variant": "ghost",
      "title": "Show Inspector",
      "aria-pressed": "false",
      "_on": {
        "click": {
          "_module": "xstudio",
          "_op": "toggle-portlet",
          "_params": {
            "_portlet": "inspector"
          }
        }
      }
    },
    {
      "_id": "xstudio-portlet-toggle-json",
      "_type": "button",
      "class": "xstudio-portlet-toggle",
      "_text": "JSON",
      "_variant": "ghost",
      "title": "Show JSON",
      "aria-pressed": "false",
      "_on": {
        "click": {
          "_module": "xstudio",
          "_op": "toggle-portlet",
          "_params": {
            "_portlet": "json"
          }
        }
      }
    },
    {
      "_id": "xstudio-portlet-toggle-modules",
      "_type": "button",
      "class": "xstudio-portlet-toggle",
      "_text": "Modules",
      "_variant": "ghost",
      "title": "Show Modules",
      "aria-pressed": "false",
      "_on": {
        "click": {
          "_module": "xstudio",
          "_op": "toggle-portlet",
          "_params": {
            "_portlet": "modules"
          }
        }
      }
    },
    {
      "_id": "xstudio-portlet-toggle-runtime",
      "_type": "button",
      "class": "xstudio-portlet-toggle",
      "_text": "Runtime",
      "_variant": "ghost",
      "title": "Show Runtime",
      "aria-pressed": "false",
      "_on": {
        "click": {
          "_module": "xstudio",
          "_op": "toggle-portlet",
          "_params": {
            "_portlet": "runtime"
          }
        }
      }
    },
    {
      "_id": "xstudio-toggle-left-dock",
      "_type": "button",
      "class": "xstudio-dock-toggle xstudio-icon-button",
      "_text": "◀",
      "_variant": "ghost",
      "title": "Collapse left dock",
      "aria-label": "Collapse left dock",
      "_on": {
        "click": {
          "_module": "xem",
          "_op": "fire",
          "_params": {
            "event": "studio:toggle-left-dock"
          }
        }
      }
    },
    {
      "_id": "xstudio-object-picker-toggle",
      "_type": "button",
      "class": "xstudio-object-picker-toggle xstudio-icon-button",
      "_variant": "ghost",
      "title": "Select object from canvas (⌘⇧C)",
      "aria-label": "Select object from canvas (⌘⇧C)",
      "aria-pressed": "false",
      "_children": [
        {
          "_type": "svg",
          "class": "xstudio-object-picker-icon",
          "viewBox": "0 0 24 24",
          "fill": "none",
          "xmlns": "http://www.w3.org/2000/svg",
          "aria-hidden": "true",
          "focusable": "false",
          "_children": [
            {
              "_type": "rect",
              "x": "4",
              "y": "4",
              "width": "16",
              "height": "16",
              "rx": "2",
              "fill": "none",
              "stroke": "currentColor",
              "stroke-width": "1.8"
            },
            {
              "_type": "path",
              "d": "M8 8l8 4-4 1.5L10.5 17 8 8z",
              "fill": "none",
              "stroke": "currentColor",
              "stroke-width": "1.8",
              "stroke-linejoin": "round"
            }
          ]
        }
      ],
      "_on": {
        "click": {
          "_module": "xem",
          "_op": "fire",
          "_params": {
            "event": "studio:object-picker-toggle"
          }
        }
      }
    },
    {
      "_id": "xstudio-arrange-toggle",
      "_type": "button",
      "class": "xstudio-arrange-toggle xstudio-icon-button",
      "_variant": "ghost",
      "title": "Arrange objects",
      "aria-label": "Arrange objects",
      "aria-pressed": "false",
      "_children": [
        {
          "_type": "svg",
          "class": "xstudio-arrange-icon",
          "viewBox": "0 0 24 24",
          "fill": "none",
          "xmlns": "http://www.w3.org/2000/svg",
          "aria-hidden": "true",
          "focusable": "false",
          "_children": [
            {
              "_type": "path",
              "d": "M12 3v18M3 12h18",
              "fill": "none",
              "stroke": "currentColor",
              "stroke-width": "1.8",
              "stroke-linecap": "round"
            },
            {
              "_type": "path",
              "d": "M12 3l-3 3M12 3l3 3M12 21l-3-3M12 21l3-3M3 12l3-3M3 12l3 3M21 12l-3-3M21 12l-3 3",
              "fill": "none",
              "stroke": "currentColor",
              "stroke-width": "1.8",
              "stroke-linecap": "round",
              "stroke-linejoin": "round"
            }
          ]
        }
      ],
      "_on": {
        "click": {
          "_module": "xem",
          "_op": "fire",
          "_params": {
            "event": "studio:arrange-toggle"
          }
        }
      }
    },
    {
      "_id": "xstudio-toggle-right-dock",
      "_type": "button",
      "class": "xstudio-dock-toggle xstudio-icon-button",
      "_text": "▶",
      "_variant": "ghost",
      "title": "Collapse right dock",
      "aria-label": "Collapse right dock",
      "_on": {
        "click": {
          "_module": "xem",
          "_op": "fire",
          "_params": {
            "event": "studio:toggle-right-dock"
          }
        }
      }
    },
    {
      "_type": "label",
      "class": "xstudio-edit-mode",
      "_text": "EDIT MODE"
    }
  ]
}
